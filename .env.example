# PostgreSQL Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_SECRET_KEY=energy-demand-secret-key
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FIRSTNAME=Admin
AIRFLOW_LASTNAME=User
AIRFLOW_EMAIL=admin@example.com

# Additional Python packages for Airflow (comma separated)
_PIP_ADDITIONAL_REQUIREMENTS=pandas numpy scikit-learn xgboost requests psycopg2-binary sqlalchemy

# API Keys (replace with your actual keys)
WEATHER_API_KEY=your_weather_api_key_here
ENERGY_API_KEY=your_energy_api_key_here
